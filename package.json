{
  "name": "cumea",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, self-hosted AI teammates that run on infrastructure you control.",
  "author": "metaforismo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/metaforismo/Cumea.git"
  },
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.ts",
    "dev:desktop": "electron .",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "test": "vitest run && pnpm test:cua-contract && pnpm test:performance",
    "test:cua-contract": "node --test electron/cua-contract.test.mjs",
    "test:watch": "vitest",
    "mobile:start": "pnpm --dir apps/mobile start",
    "mobile:ios": "pnpm --dir apps/mobile ios",
    "mobile:android": "pnpm --dir apps/mobile android",
    "mobile:test": "pnpm --dir apps/mobile test",
    "mobile:typecheck": "pnpm --dir apps/mobile typecheck",
    "mobile:export": "pnpm --dir apps/mobile export",
    "preview": "vite preview",
    "build:server": "tsc -p tsconfig.server.build.json",
    "build:speech": "swiftc -O -module-cache-path build/.swift-module-cache electron/resources/speech-helper.swift -o electron/resources/speech-helper",
    "build:speech:arm64": "swiftc -O -target arm64-apple-macos13.0 -module-cache-path build/.swift-module-cache electron/resources/speech-helper.swift -o electron/resources/speech-helper",
    "prepare:cua-driver": "node scripts/prepare-cua-driver.mjs",
    "package": "pnpm package:mac",
    "package:mac": "pnpm prepare:cua-driver && pnpm build && pnpm build:server && pnpm build:speech:arm64 && electron-builder --mac --publish never",
    "package:mac:dir": "pnpm prepare:cua-driver && pnpm build && pnpm build:server && pnpm build:speech:arm64 && electron-builder --mac --arm64 --dir --publish never",
    "package:linux": "pnpm build && pnpm build:server && electron-builder --linux --publish never",
    "package:win": "pnpm build && pnpm build:server && electron-builder --win --publish never",
    "release:sbom": "node scripts/generate-sbom.mjs",
    "release:checksums": "node scripts/generate-checksums.mjs --directory release --output release/SHA256SUMS",
    "release:verify-package": "node scripts/verify-package-contents.mjs",
    "test:performance": "node --test electron/performance.test.mjs scripts/perf-lib.test.mjs",
    "perf:budget": "node scripts/check-performance-budget.mjs",
    "perf:summary": "node scripts/perf-summary.mjs",
    "perf:compare": "node scripts/perf-compare.mjs"
  },
  "dependencies": {
    "@trycua/cua-driver": "0.19.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.539.0",
    "qrcode.react": "4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^7.1.0",
    "vitest": "^4.1.10"
  }
}
